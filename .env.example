COMPOSE_PROJECT_NAME=thingsboard_edge
COMPOSE_PROFILES=development
# Na topologia Docker local, o serviço da Central é alcançado por este nome
# na rede externa compartilhada io_thingsboard. Em produção, substitua pelo
# DNS interno/hostname que o Edge alcançar diretamente.
TB_SERVER=thingsboard
TB_EDGE_KEY=GET_IN_TB_SERVER
TB_EDGE_SECRET=GET_IN_TB_SERVER
PORT_WEB=9190
PORT_MQTT=9883
PORT_MQTTS=9884
# MQTT simples e MQTTS do Edge são listeners locais independentes do RPC
# Edge-Central. Os defaults usam os certificados de desenvolvimento da Central.
MQTT_ENABLED=true
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_SSL_ENABLED=true
MQTT_SSL_CERT_FILE=../thingsboard/certs/server.pem
MQTT_SSL_KEY_FILE=../thingsboard/certs/server_key.pem
# Host UDP ports for Edge CoAP (the local Central uses 5683-5688).
PORT_COAP_START=6583
PORT_COAP_END=6588
PORT_PGADMIN=9191
DB_USER=edge
DB_PASSWORD=secret
PGADMIN_USER=first.surname@embrapa.br
PGADMIN_PASSWORD=secret
VOLUME_DB=thingsboard_edge_db
VOLUME_EDGE=thingsboard_edge_data
VOLUME_LOG=thingsboard_edge_log
VOLUME_BACKUP=thingsboard_edge_backup
VOLUME_PGADMIN=thingsboard_edge_pgadmin
